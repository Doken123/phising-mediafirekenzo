{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/verif" },
    { "source": "/verif", "destination": "/verif.html" },
    { "source": "/blokir", "destination": "/blokir.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/api/send", "destination": "/api/send" }
  ],
  "functions": {
    "api/send.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
